{
  "name": "youtube-mpv-shim",
  "version": "1.0.5",
  "description": "Cast YouTube to mpv: your PC appears as a YouTube cast target and plays videos in a local mpv window",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p1nkhamster/youtube-mpv-shim.git"
  },
  "bin": {
    "youtube-mpv-shim": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets",
    "extension",
    "autostart",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "undici": "^8.10.0",
    "youtubei.js": "^16.0.1",
    "yt-cast-receiver": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
