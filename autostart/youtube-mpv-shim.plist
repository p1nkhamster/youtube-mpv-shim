<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent (macos): cp to ~/Library/LaunchAgents/ and run
     launchctl load ~/Library/LaunchAgents/youtube-mpv-shim.plist
     adjust the two paths below to the output of
     `which node` and `which youtube-mpv-shim` -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>youtube-mpv-shim</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/opt/homebrew/bin/youtube-mpv-shim</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
